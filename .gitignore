# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Model weights (large binary files) — ASR, forced-aligner, VL, and the
# HF cache layout (models--Qwen--*). Nothing in Qwen/ is source.
Qwen/

# Demucs vocal separation output
separated/

# Transcription output
*.jsonl
transcription*.json

# Audio/video input files
data/

# Logs
*.log

# IDE
.vscode/
.idea/

# macOS
.DS_Store

# Runtime config written by web_server.py (/api/config)
asr_config.json

# yt-dlp cache for URL inputs
downloads/

# Evaluation audio (large); the paired transcripts are tracked as fixtures.
ground_truth/*.wav

# Captured live audio (CAPTURE_AUDIO=true)
captures/

# Lecture recordings and their transcripts are course material, not public.
# Only the AIMX conference samples (public sessions) stay tracked as fixtures.
ground_truth/*
!ground_truth/aimx_*
!ground_truth/segment_tuning_README.md
!ground_truth/vllm_streaming_test_README.md
test_results/*
!test_results/aimx_*
